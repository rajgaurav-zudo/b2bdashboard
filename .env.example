# Copy to .env and fill in. .env is gitignored and must stay that way.

# --- local stack (docker compose) -------------------------------------------
POSTGRES_USER=b2b
POSTGRES_PASSWORD=b2b
POSTGRES_DB=b2bdash
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=5173

# --- auth (Sign in with Google) ----------------------------------------------
# On unless set to false. The local compose stack sets AUTH_REQUIRED=false so
# development needs no account; anything that does not say so is protected.
AUTH_REQUIRED=false

# Only read when AUTH_REQUIRED=true.
# The OAuth 2.0 Client ID of type "Web application" from Google Cloud Console
# (APIs & Services > Credentials). Public: it ships to the browser. The origin
# the app is opened on must be listed under its Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Signs the API's session tokens. Secret, at least 32 characters:
#   openssl rand -hex 32
AUTH_SESSION_SECRET=

# Who is allowed in: the Google Workspace domain an account must belong to,
# checked by the API. Defaults to ["edvoy.com"] when unset.
AUTH_ALLOWED_DOMAINS=["edvoy.com"]
# The owner: written into the user list at every start, manages everyone else
# from the Users page, and cannot be changed or removed from the app. Everybody
# else has to be added on that page before they can sign in.
AUTH_OWNER_EMAIL=raj@edvoy.com
