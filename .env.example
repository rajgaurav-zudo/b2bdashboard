# Copy to .env and fill in. .env is gitignored and must stay that way.

# --- local stack (docker compose) -------------------------------------------
POSTGRES_USER=b2b
POSTGRES_PASSWORD=b2b
POSTGRES_DB=b2bdash
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=5173

# --- Supabase ----------------------------------------------------------------
# Project ref is the subdomain of the project URL. Not a secret.
SUPABASE_PROJECT_REF=kkwpxngibdmgletvtbbv
SUPABASE_URL=https://kkwpxngibdmgletvtbbv.supabase.co

# Settings > API. The anon key is public and ships to the browser; the service
# role key bypasses every row-level security policy, so it is server-side only
# and must never reach the web bundle.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Settings > Database > Connection string > Transaction pooler (port 6543).
# Session pooler (5432) also works. Prepared statements are disabled either way
# because the transaction pooler cannot keep them alive between transactions --
# see api/app/db.py.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_URL=

# Storage bucket for the uploaded exports. Private: these are CRM extracts.
SUPABASE_STORAGE_BUCKET=uploads

# CLI credentials. Signing in to the Supabase dashboard with GitHub does not
# authenticate the CLI -- it needs its own token. Generate one at
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Settings > Database > Database password. Needed by `supabase link`.
SUPABASE_DB_PASSWORD=

# --- auth --------------------------------------------------------------------
# On unless set to false. The local compose stack sets AUTH_REQUIRED=false so
# development needs no account; anything that does not say so is protected.
AUTH_REQUIRED=false

# Who is allowed in, checked by the API against the token's verified email claim.
# A valid Supabase token proves only that someone signed up, so at least one of
# these must be set or the API refuses to start.
#   AUTH_ALLOWED_DOMAINS=["edvoy.com"]
#   AUTH_ALLOWED_EMAILS=["someone@gmail.com"]
AUTH_ALLOWED_DOMAINS=[]
AUTH_ALLOWED_EMAILS=[]
